#!/bin/sh
# PardusInsight kurulum sonrası betiği: yalnızca uygulamanın Python bayt kodunu
# derler. Sistem ayarı değiştirmez, servis kurmaz.
set -e

case "$1" in
    configure)
        if command -v py3compile >/dev/null 2>&1; then
            py3compile -p pardusinsight /usr/share/pardusinsight || true
        fi
        ;;
esac

exit 0
